[{"key":"GR","place":"그리스","code":"GR","foods":[{"original":"Moussaka","korean":"무사카","description":"가지와 감자, 다진 고기를 층층이 쌓고 베샤멜 소스를 얹어 오븐에 구운 요리입니다.","analogy":"라자냐와 비슷하지만 면 대신 가지와 감자를 사용하여 훨씬 부드럽고 담백합니다.","emoji":"🍆","dessert":false,"scope":"country"},{"original":"Souvlaki","korean":"수블라키","description":"작게 썬 고기를 꼬치에 끼워 숯불에 구운 뒤 피타 빵과 함께 먹는 요리입니다.","analogy":"한국의 닭꼬치와 비슷하지만 올리브유와 허브 향이 강하게 느껴집니다.","emoji":"🍢","dessert":false,"scope":"country"},{"original":"Baklava","korean":"바클라바","description":"얇은 필로 반죽 사이에 견과류를 넣고 꿀이나 시럽을 듬뿍 뿌린 페이스트리입니다.","analogy":"약과처럼 꿀의 단맛이 강하고 겹겹이 쌓인 반죽의 바삭한 식감이 특징입니다.","emoji":"🍯","dessert":true,"scope":"country"},{"original":"Greek Salad","korean":"그릭 샐러드","description":"토마토, 오이, 양파, 올리브, 페타 치즈를 큼직하게 썰어 올리브유를 뿌린 샐러드입니다.","analogy":"한국의 채소 무침처럼 신선하지만 치즈의 짭짤한 풍미가 더해져 있습니다.","emoji":"🥗","dessert":false,"scope":"country"},{"original":"Dolmades","korean":"돌마데스","description":"포도 잎에 쌀과 허브, 다진 고기를 넣고 돌돌 말아 쪄낸 요리입니다.","analogy":"깻잎 쌈밥과 비슷하지만 포도 잎 특유의 새콤한 향이 배어 있습니다.","emoji":"🍃","dessert":false,"scope":"country"},{"original":"Spanakopita","korean":"스파나코피타","description":"시금치와 페타 치즈를 섞어 필로 반죽으로 감싸 구운 파이입니다.","analogy":"야채 호떡과 비슷하지만 겉면이 훨씬 얇고 바삭한 페이스트리 형태입니다.","emoji":"🥧","dessert":false,"scope":"country"},{"original":"Gyros","korean":"기로스","description":"회전하는 꼬치에 구운 고기를 얇게 썰어 피타 빵에 채소와 함께 싸 먹는 요리입니다.","analogy":"케밥과 비슷하며 고기의 육즙과 요거트 소스의 조화가 좋습니다.","emoji":"🌯","dessert":false,"scope":"country"},{"original":"Pastitsio","korean":"파스티치오","description":"마카로니 면에 다진 고기 소스와 베샤멜 소스를 얹어 구운 그리스식 파스타입니다.","analogy":"그라탕과 비슷하지만 시나몬 향이 살짝 가미되어 독특한 풍미를 냅니다.","emoji":"🍝","dessert":false,"scope":"country"},{"original":"Keftedes","korean":"케프테데스","description":"다진 고기에 허브와 향신료를 섞어 동그랗게 빚어 튀겨낸 그리스식 미트볼입니다.","analogy":"동그랑땡과 비슷하지만 허브 향이 강하고 겉은 더 바삭합니다.","emoji":"🧆","dessert":false,"scope":"country"},{"original":"Fasolada","korean":"파솔라다","description":"흰 강낭콩, 토마토, 당근, 셀러리 등을 넣고 푹 끓여낸 전통 콩 수프입니다.","analogy":"콩비지찌개처럼 걸쭉하고 담백하며 건강한 맛이 납니다.","emoji":"🍲","dessert":false,"scope":"country"},{"original":"Loukoumades","korean":"루쿠마데스","description":"작은 반죽을 튀겨 꿀과 시나몬 가루를 뿌려 먹는 그리스식 도넛입니다.","analogy":"찹쌀 도넛과 비슷하지만 꿀에 절여져 있어 훨씬 촉촉하고 달콤합니다.","emoji":"🍩","dessert":true,"scope":"country"},{"original":"Galaktoboureko","korean":"갈락토부레코","description":"필로 반죽 사이에 세몰리나 커스터드 크림을 채워 구운 뒤 시럽을 뿌린 디저트입니다.","analogy":"슈크림 빵과 비슷하지만 겉면이 겹겹이 바삭한 페이스트리로 되어 있습니다.","emoji":"🍰","dessert":true,"scope":"country"},{"original":"Halva","korean":"할바","description":"참깨 페이스트인 타히니에 설탕이나 꿀을 섞어 굳힌 디저트입니다.","analogy":"깨강정과 비슷하지만 입안에서 부드럽게 녹아내리는 식감입니다.","emoji":"🍬","dessert":true,"scope":"country"},{"original":"Kataifi","korean":"카타이피","description":"실처럼 가느다란 반죽 안에 견과류를 넣고 말아 시럽에 적신 디저트입니다.","analogy":"실타래 과자와 비슷하지만 견과류의 고소함이 더 강합니다.","emoji":"🍮","dessert":true,"scope":"country"},{"original":"Avgolemono","korean":"아브골레모노","description":"닭 육수에 달걀노른자와 레몬즙을 섞어 걸쭉하게 만든 수프입니다.","analogy":"닭죽과 비슷하지만 레몬의 상큼한 맛이 더해져 입맛을 돋웁니다.","emoji":"🥣","dessert":false,"scope":"country"},{"original":"Stifado","korean":"스티파도","description":"고기와 작은 양파를 토마토 소스, 와인, 향신료와 함께 오래 끓인 스튜입니다.","analogy":"갈비찜과 비슷하지만 토마토의 산미와 향신료 향이 특징입니다.","emoji":"🥘","dessert":false,"scope":"country"},{"original":"Gemista","korean":"게미스타","description":"토마토나 피망 속을 파내고 쌀과 허브, 다진 고기를 채워 오븐에 구운 요리입니다.","analogy":"고추전이나 피망 속을 채운 요리와 비슷하지만 쌀이 들어가 든든합니다.","emoji":"🍅","dessert":false,"scope":"country"},{"original":"Saganaki","korean":"사가나키","description":"치즈를 팬에 올려 겉면이 노릇해질 때까지 구워낸 요리입니다.","analogy":"치즈 구이와 비슷하며 짭짤하고 쫄깃한 식감이 일품입니다.","emoji":"🧀","dessert":false,"scope":"country"}]},{"key":"HU","place":"헝가리","code":"HU","foods":[{"original":"Gulyás","korean":"굴야쉬","description":"소고기, 양파, 파프리카 가루를 넣고 푹 끓여낸 헝가리식 고기 수프입니다.","analogy":"육개장과 비슷하지만 고춧가루 대신 파프리카 가루를 사용하여 맵지 않고 부드럽습니다.","emoji":"🍲","dessert":false,"scope":"country"},{"original":"Lángos","korean":"랑고쉬","description":"밀가루 반죽을 튀긴 뒤 마늘 소스, 사워크림, 치즈를 듬뿍 얹어 먹는 길거리 음식입니다.","analogy":"호떡과 비슷하지만 튀긴 반죽 위에 짭짤한 토핑을 얹어 식사 대용으로 먹습니다.","emoji":"🍕","dessert":false,"scope":"country"},{"original":"Dobos Torta","korean":"도보스 토르타","description":"스펀지 케이크 층 사이에 초콜릿 버터크림을 바르고 맨 위에 캐러멜을 얹은 케이크입니다.","analogy":"초코 케이크와 비슷하지만 맨 위의 딱딱한 캐러멜 층이 독특한 식감을 줍니다.","emoji":"🍰","dessert":true,"scope":"country"},{"original":"Pörkölt","korean":"푀르쾰트","description":"고기를 양파와 파프리카 가루로 만든 진한 소스에 볶듯이 끓여낸 요리입니다.","analogy":"갈비찜과 비슷하지만 국물이 자작하고 고기가 매우 부드럽습니다.","emoji":"🥘","dessert":false,"scope":"country"},{"original":"Töltött Káposzta","korean":"퇼퇴트 카포스타","description":"절인 양배추 잎에 다진 고기와 쌀을 넣고 돌돌 말아 토마토 소스에 끓인 요리입니다.","analogy":"양배추 쌈과 비슷하지만 새콤한 맛이 배어 있어 입맛을 돋웁니다.","emoji":"🥬","dessert":false,"scope":"country"},{"original":"Csirkepaprikás","korean":"치르케 파프리카쉬","description":"닭고기를 파프리카 가루와 사워크림을 넣은 소스에 부드럽게 끓여낸 요리입니다.","analogy":"닭볶음탕과 비슷하지만 사워크림 덕분에 훨씬 크리미하고 부드럽습니다.","emoji":"🍗","dessert":false,"scope":"country"},{"original":"Halászlé","korean":"할라스레","description":"민물고기를 파프리카 가루와 함께 끓여낸 매콤한 생선 수프입니다.","analogy":"매운탕과 비슷하지만 생선 살이 으깨질 정도로 푹 끓여 국물이 진합니다.","emoji":"🐟","dessert":false,"scope":"country"},{"original":"Rakott Krumpli","korean":"라코트 크룸플리","description":"감자, 삶은 달걀, 소시지를 층층이 쌓고 사워크림을 얹어 오븐에 구운 요리입니다.","analogy":"감자 그라탕과 비슷하며 든든한 한 끼 식사로 좋습니다.","emoji":"🥔","dessert":false,"scope":"country"},{"original":"Hortobágyi Palacsinta","korean":"호르토바지 팔라친타","description":"고기를 채운 크레페에 파프리카 크림소스를 얹어 먹는 요리입니다.","analogy":"고기 만두를 얇은 전병에 싸서 소스를 얹은 것과 비슷한 느낌입니다.","emoji":"🥞","dessert":false,"scope":"country"},{"original":"Rántott Hús","korean":"란토트 후쉬","description":"고기를 얇게 펴서 빵가루를 입혀 튀겨낸 헝가리식 커틀릿입니다.","analogy":"돈가스와 비슷하지만 고기가 더 얇고 바삭하게 튀겨져 있습니다.","emoji":"🥩","dessert":false,"scope":"country"},{"original":"Kürtőskalács","korean":"쿠르토슈칼라치","description":"원통형 틀에 반죽을 감아 숯불에 구운 뒤 설탕이나 시나몬 가루를 묻힌 빵입니다.","analogy":"꽈배기 도넛과 비슷하지만 겉은 바삭하고 속은 쫄깃한 식감이 특징입니다.","emoji":"🥖","dessert":true,"scope":"country"},{"original":"Somlói Galuska","korean":"솜로이 갈루슈카","description":"스펀지 케이크 조각에 초콜릿 소스, 견과류, 휘핑크림을 얹은 디저트입니다.","analogy":"트라이플과 비슷하며 여러 가지 맛이 섞여 풍부한 단맛을 냅니다.","emoji":"🍨","dessert":true,"scope":"country"},{"original":"Gundel Palacsinta","korean":"군델 팔라친타","description":"호두와 럼, 건포도를 채운 크레페에 따뜻한 초콜릿 소스를 뿌린 디저트입니다.","analogy":"호떡과 비슷하지만 초콜릿 소스가 더해져 훨씬 고급스러운 맛입니다.","emoji":"🍫","dessert":true,"scope":"country"},{"original":"Bejgli","korean":"베이글리","description":"호두나 양귀비 씨앗 페이스트를 듬뿍 넣어 돌돌 말아 구운 롤 케이크입니다.","analogy":"호두 파이와 비슷하지만 빵의 식감이 더 쫄깃합니다.","emoji":"🥐","dessert":true,"scope":"country"},{"original":"Túrós Csusza","korean":"투로쉬 추사","description":"넓은 면에 코티지 치즈와 베이컨을 얹어 먹는 헝가리식 파스타입니다.","analogy":"치즈 파스타와 비슷하지만 짭짤한 베이컨이 더해져 감칠맛이 납니다.","emoji":"🍝","dessert":false,"scope":"country"},{"original":"Hideg Gyümölcsleves","korean":"히데그 규묄치레베쉬","description":"체리나 베리류 과일을 넣고 차갑게 만든 과일 수프입니다.","analogy":"화채와 비슷하지만 훨씬 걸쭉하고 부드러운 식감입니다.","emoji":"🍒","dessert":false,"scope":"country"},{"original":"Székely Gulyás","korean":"세케이 굴야쉬","description":"고기와 절인 양배추를 넣고 끓인 굴야쉬의 변형 요리입니다.","analogy":"김치찌개와 비슷하지만 김치 대신 절인 양배추를 사용하여 새콤한 맛이 납니다.","emoji":"🥘","dessert":false,"scope":"country"},{"original":"Krémes","korean":"크레메쉬","description":"두 겹의 페이스트리 사이에 두꺼운 바닐라 커스터드 크림을 채운 디저트입니다.","analogy":"슈크림 빵과 비슷하지만 크림의 양이 훨씬 많고 부드럽습니다.","emoji":"🍮","dessert":true,"scope":"country"}]},{"key":"IS","place":"아이슬란드","code":"IS","foods":[{"original":"Plokkfiskur","korean":"플로크피스크르","description":"대구와 같은 흰 살 생선을 감자와 함께 으깨어 화이트 소스에 섞어 만든 요리입니다.","analogy":"감자 샐러드와 비슷하지만 생선의 담백한 맛이 더해져 든든합니다.","emoji":"🐟","dessert":false,"scope":"country"},{"original":"Pylsur","korean":"필수르","description":"양고기를 베이스로 만든 소시지를 핫도그 빵에 끼워 먹는 아이슬란드식 핫도그입니다.","analogy":"일반 핫도그와 비슷하지만 양고기 특유의 풍미가 느껴집니다.","emoji":"🌭","dessert":false,"scope":"country"},{"original":"Skyr","korean":"스카이르","description":"우유를 발효시켜 만든 아이슬란드 전통 유제품으로 요거트와 비슷합니다.","analogy":"그릭 요거트와 비슷하지만 훨씬 꾸덕하고 단백질 함량이 높습니다.","emoji":"🍨","dessert":true,"scope":"country"},{"original":"Hangikjöt","korean":"항기쿄트","description":"양고기를 훈연하여 익힌 뒤 얇게 썰어 먹는 전통 요리입니다.","analogy":"베이컨과 비슷하지만 훈연 향이 훨씬 깊고 고기 맛이 진합니다.","emoji":"🍖","dessert":false,"scope":"country"},{"original":"Kjötsúpa","korean":"쿄트수파","description":"양고기와 각종 채소를 넣고 푹 끓여낸 아이슬란드식 고기 수프입니다.","analogy":"갈비탕과 비슷하지만 채소의 단맛이 우러나와 국물이 담백합니다.","emoji":"🍲","dessert":false,"scope":"country"},{"original":"Rúgbrauð","korean":"루그브라우드","description":"지열을 이용해 땅속에서 오랫동안 구워낸 밀도 높은 호밀 빵입니다.","analogy":"술빵과 비슷하지만 훨씬 묵직하고 단맛이 은은하게 납니다.","emoji":"🍞","dessert":false,"scope":"country"},{"original":"Harðfiskur","korean":"하르드피스크르","description":"대구 등을 바람에 말려 딱딱하게 만든 건어물입니다.","analogy":"쥐포와 비슷하지만 양념이 되어 있지 않아 생선 본연의 맛이 강합니다.","emoji":"🐟","dessert":false,"scope":"country"},{"original":"Svið","korean":"스비드","description":"양의 머리를 반으로 잘라 삶아낸 전통 요리입니다.","analogy":"족발과 비슷하게 쫄깃한 식감과 고소한 맛이 특징입니다.","emoji":"🐑","dessert":false,"scope":"country"},{"original":"Lax","korean":"락스","description":"아이슬란드의 깨끗한 물에서 잡은 신선한 연어를 구이나 훈제로 즐기는 요리입니다.","analogy":"연어 스테이크와 비슷하며 살이 매우 부드럽습니다.","emoji":"🍣","dessert":false,"scope":"country"},{"original":"Humarsúpa","korean":"후마르수파","description":"아이슬란드산 바닷가재를 넣어 끓인 진하고 고소한 수프입니다.","analogy":"꽃게탕과 비슷하지만 크림이 들어가 훨씬 부드럽습니다.","emoji":"🦞","dessert":false,"scope":"country"},{"original":"Kleina","korean":"클레이나","description":"반죽을 꼬아서 튀겨낸 아이슬란드식 꽈배기 도넛입니다.","analogy":"꽈배기와 비슷하지만 카다멈 향이 은은하게 납니다.","emoji":"🍩","dessert":true,"scope":"country"},{"original":"Pönnukökur","korean":"푀누쾨퀴르","description":"얇게 부쳐낸 팬케이크에 설탕이나 잼을 발라 돌돌 말아 먹는 디저트입니다.","analogy":"크레페와 비슷하며 얇고 부드러운 식감이 특징입니다.","emoji":"🥞","dessert":true,"scope":"country"},{"original":"Vínarterta","korean":"비나르테르타","description":"얇은 케이크 층 사이에 자두 잼을 겹겹이 바른 전통 케이크입니다.","analogy":"겹겹이 쌓인 샌드 쿠키와 비슷하며 자두의 새콤달콤한 맛이 납니다.","emoji":"🍰","dessert":true,"scope":"country"},{"original":"Lummur","korean":"룸뮈르","description":"오트밀을 넣어 만든 작고 도톰한 팬케이크입니다.","analogy":"호떡과 비슷하지만 오트밀의 고소한 맛이 더 강합니다.","emoji":"🍪","dessert":true,"scope":"country"},{"original":"Hákarl","korean":"하우카들","description":"상어를 발효시켜 만든 전통 음식으로 독특한 향이 강합니다.","analogy":"삭힌 홍어와 비슷하게 강렬한 향과 맛이 특징입니다.","emoji":"🦈","dessert":false,"scope":"country"},{"original":"Flatkaka","korean":"플라트카카","description":"호밀 가루로 만든 얇고 납작한 빵으로 주로 버터를 발라 먹습니다.","analogy":"메밀전병과 비슷하지만 훨씬 쫄깃하고 담백합니다.","emoji":"🍞","dessert":false,"scope":"country"},{"original":"Rjómaterta","korean":"료마테르타","description":"생크림과 과일을 듬뿍 넣은 아이슬란드식 크림 케이크입니다.","analogy":"생크림 케이크와 비슷하며 부드러운 식감이 일품입니다.","emoji":"🎂","dessert":true,"scope":"country"},{"original":"Lambakjöt","korean":"람바쿄트","description":"아이슬란드에서 방목하여 키운 양고기를 구워낸 요리입니다.","analogy":"양갈비 구이와 비슷하며 육질이 매우 연합니다.","emoji":"🥩","dessert":false,"scope":"country"}]}]