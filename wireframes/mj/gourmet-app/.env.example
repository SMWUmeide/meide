GOOGLE_SEARCH_MONTHLY_LIMIT=100
GOOGLE_NEARBY_MONTHLY_LIMIT=100
GOOGLE_PHOTO_MONTHLY_LIMIT=300

# Gemini menu recognition
GEMINI_API_KEY=
