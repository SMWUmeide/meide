# Native builds need a deployed HTTPS API; web preview uses the same origin by default.
# Copy into .env.local for local development; configure the same public values in
# Expo environments (development / preview / production) for cloud builds.
# Use origins without a path. EXPO_PUBLIC values are bundled into the app, never secrets.
# EXPO_PUBLIC_COMPANION_API_URL=https://your-api.example.com
# API server: persist this path on disk; run one server instance for the JSON registry.
# INVITE_DB_PATH=/persistent/meide/invites.json
# HOST=127.0.0.1
# PORT=5190
# ALLOWED_ORIGINS=https://your-web.example.com

# Public web URL used in copied/shared invitations. Native builds require this.
# EXPO_PUBLIC_INVITE_WEB_URL=https://your-web.example.com

# Separate client map keys. Never copy the existing server keys here.
# Restrict this key to Maps SDK for Android AND package name + signing SHA-1.
# GOOGLE_MAPS_ANDROID_API_KEY=
# Optional iOS: Maps SDK for iOS AND the bundle identifier.
# GOOGLE_MAPS_IOS_API_KEY=
# Web key lives in server/.env.local as GOOGLE_MAPS_WEB_API_KEY.
# The server authorizes each map load before returning this restricted client key.
# Optional production map ID; development uses Google's DEMO_MAP_ID.
# EXPO_PUBLIC_GOOGLE_MAPS_WEB_MAP_ID=
