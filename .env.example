# 서버에서만 사용하는 키예요. 실제 값은 .env.local 또는 Vercel Secret에 넣어요.
GEMINI_API_KEY=
# 선택 설정이에요. 비워 두면 gemini-3.5-flash-lite를 사용해요.
GEMINI_MODEL=

# 서버에서 허용하는 앱 origin이에요. Android 기본 주소만 허용해요.
NATIVE_APP_ORIGINS=https://localhost

# 브라우저에 공개되는 서버 주소예요. 키를 넣으면 안 돼요.
# 로컬 웹 개발은 비워 두고, Android에는 https://api.example.com 같은 origin을 넣어요.
VITE_API_BASE_URL=

# Play 제출 전에 확정할 앱 ID예요. 예: com.company.meide
MEIDE_APPLICATION_ID=

# 음식 대표 사진 검색 (서버 전용)
PEXELS_API_KEY=

# Supabase 공개 설정. service_role / secret 키는 절대 넣지 않아요.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Android에서 보내는 초대 링크의 웹 앱 주소 (예: https://meide.example.com)
VITE_APP_URL=

# 서버 전용: 재시작/서버 증설에도 유지되는 호출 카운터
# 위의 VITE_SUPABASE_URL과 같은 프로젝트예요. service_role 키는 VITE_에 넣지 않아요.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_MINUTE_LIMIT=5
GEMINI_DAILY_LIMIT=50
PEXELS_HOURLY_LIMIT=100
PEXELS_MONTHLY_LIMIT=1000

# 선택: 사진 누끼 + 흰 배경. 기본 0회로 비활성화해요.
# 새 계정의 무료 체험이 남아 있는지 확인한 뒤 최대 10 등으로 설정해요.
PHOTOROOM_API_KEY=
PHOTOROOM_LIFETIME_LIMIT=0

# Pixabay 음식 사진 검색용 서버 키
PIXABAY_API_KEY=
PIXABAY_MINUTE_LIMIT=20
PIXABAY_DAILY_LIMIT=200

# Free self-hosted foreground segmentation (no external API key)
CUTOUT_MINUTE_LIMIT=20
CUTOUT_DAILY_LIMIT=200
