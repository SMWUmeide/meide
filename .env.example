# 서버에서만 사용하는 키예요. 실제 값은 .env.local 또는 Vercel Secret에 넣어요.
GEMINI_API_KEY=
# 선택 설정이에요. 비워 두면 gemini-3.5-flash-lite를 사용해요.
GEMINI_MODEL=

# 서버에서 허용하는 앱 origin이에요. Android 기본 주소만 허용해요.
NATIVE_APP_ORIGINS=https://localhost

# 브라우저에 공개되는 서버 주소예요. 키를 넣으면 안 돼요.
# 로컬 웹 개발은 비워 두고, Android에는 https://api.example.com 같은 origin을 넣어요.
VITE_API_BASE_URL=

# Play 제출 전에 확정할 앱 ID예요. 예: com.company.meide
MEIDE_APPLICATION_ID=

# 음식 대표 사진 검색 (서버 전용)
PEXELS_API_KEY=

# Supabase 공개 설정. service_role / secret 키는 절대 넣지 않아요.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Android에서 보내는 초대 링크의 웹 앱 주소 (예: https://meide.example.com)
VITE_APP_URL=
