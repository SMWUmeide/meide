# Copy to server/.env.local. Never put secrets in EXPO_PUBLIC_* variables.
OPENAI_API_KEY=
# Disabled until the owner confirms credit/budget and expiry. No paid calls by default.
MENU_AI_ENABLED=false
MENU_AI_TOTAL_ALLOWANCE_USD=0
MENU_AI_ALLOWANCE_EXPIRES_AT=
# Comma-separated profile IDs for closed testing. Do not put profile tokens here.
MENU_AI_ALLOWED_PROFILE_IDS=
# Persistent file, ONE server process only. Do not erase to reset allowance.
# MENU_AI_LEDGER_PATH=/persistent/meide/menu-ai-usage.json

# Closed Google API pilot. Dates use Asia/Seoul; 25 days, ends 2026-12-10 00:00 KST.
# Keep disabled until all testers and Google adapters have been configured.
MENU_TEST_ENABLED=false
MENU_TEST_START_DATE=2026-11-15
# Up to 12 registered profile UUIDs, never profile tokens.
MENU_TEST_PROFILE_IDS=
# App API reservation budget for the entire test, not a Google billing hard cap.
MENU_TEST_BUDGET_USD=125
# Local file adapter only. Cloud Run uses the shared Firestore ledger instead.
# MENU_TEST_LEDGER_PATH=/persistent/meide/menu-test-usage.json

# Server-only key restricted to Vision, Translation, and Places API (New).
GOOGLE_MENU_API_KEY=

# Server-only Maps key for one Static Maps image per restaurant search.
GOOGLE_MAPS_API_KEY=

# Browser-only key: Maps JavaScript API + allowed HTTP referrers.
# Returned only after map-load authorization; not an unrestricted server secret.
# App cap: 100 loads/day across all testers, 25-day window, shared budget.
GOOGLE_MAPS_WEB_API_KEY=

# Cloud Run uses its own service identity, never a downloaded service-account key.
# STORAGE_BACKEND=firestore
# GOOGLE_CLOUD_PROJECT=your-project
# FIRESTORE_DATABASE_ID=(default)
# FIRESTORE_NAMESPACE=pilot-2026-11
# SERVER_CONFIG_FILE=/var/secrets/meide/server-config
# TRAVEL_CACHE_DIR=/app/travel-cache
# After cloud migration, localhost forwards API requests to this HTTPS origin.
# Do not set REMOTE_API_ORIGIN on Cloud Run itself.
# REMOTE_API_ORIGIN=https://your-cloud-run-service.run.app
# Optional SHA-256 digest of a private Google Play review code (Cloud Run only).
PLAY_REVIEW_CODE_SHA256=
