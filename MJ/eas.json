{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_COMPANION_API_URL": "https://meide-api-dxnbcriiga-du.a.run.app",
        "EXPO_PUBLIC_INVITE_WEB_URL": "https://meide-api-dxnbcriiga-du.a.run.app"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_COMPANION_API_URL": "https://meide-api-dxnbcriiga-du.a.run.app",
        "EXPO_PUBLIC_INVITE_WEB_URL": "https://meide-api-dxnbcriiga-du.a.run.app"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_COMPANION_API_URL": "https://meide-api-dxnbcriiga-du.a.run.app",
        "EXPO_PUBLIC_INVITE_WEB_URL": "https://meide-api-dxnbcriiga-du.a.run.app"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
